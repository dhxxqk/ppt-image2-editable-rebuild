{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pvr/rebuild-config.schema.json",
  "title": "PVR rebuild config",
  "description": "Shape of a single-slide rebuild config. Business text, master paths and icon paths live only in the private config file and are never committed.",
  "type": "object",
  "required": ["schema", "id", "slide", "header", "typography"],
  "properties": {
    "schema": { "const": "pvr.rebuild.config/v1" },
    "id": { "type": "string", "minLength": 1 },
    "template": {
      "enum": ["milestone-timeline", "overview-two-column"],
      "description": "Page template. `milestone-timeline` requires `layout` and `cards`; `overview-two-column` requires `overview`. The loader enforces the template-specific blocks."
    },
    "overview": {
      "type": "object",
      "description": "Two-column overview page: lead paragraph, research cards, technical-route diagram. All text is an ordered run list so source bold spans survive.",
      "properties": {
        "lead": { "$ref": "#/$defs/richBlock" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/researchCard" }
        },
        "diagram": {
          "type": "object",
          "required": ["blocks"],
          "properties": {
            "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diagramBlock" } },
            "arrows": { "type": "array", "items": { "type": "object" } },
            "labels": { "type": "array", "items": { "type": "object" } },
            "feedback": { "type": "object" },
            "caption": { "type": "object" }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": { "mode": { "enum": ["prepared", "derive"] } }
    },
    "slide": {
      "type": "object",
      "required": ["master", "width_in", "height_in", "layout"],
      "properties": {
        "master": { "type": "string", "minLength": 1 },
        "master_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width_in": { "type": "number", "exclusiveMinimum": 0 },
        "height_in": { "type": "number", "exclusiveMinimum": 0 },
        "layout": { "type": "string", "minLength": 1 },
        "expected_existing_slides": { "type": "integer", "minimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "properties": { "entry": { "type": "string" } }
    },
    "python": {
      "type": "object",
      "properties": { "path": { "type": "string" } }
    },
    "render": {
      "type": "object",
      "properties": {
        "node": { "type": "string" },
        "cli": { "type": "string" },
        "dpi": { "type": "number", "exclusiveMinimum": 0 },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "normalize": { "enum": ["resample", "crop"] }
      }
    },
    "header": {
      "type": "object",
      "required": ["chapter", "pageTitle"],
      "properties": {
        "chapter": { "type": "string" },
        "pageTitle": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "description": "All geometry in inches. Values are read from here, never hardcoded in builders.",
      "additionalProperties": { "type": "number" }
    },
    "theme": {
      "type": "object",
      "description": "Colours, radii and shadows shared by the component set.",
      "additionalProperties": true
    },
    "typography": {
      "type": "object",
      "required": ["fontFamily", "bodyPt"],
      "properties": {
        "fontFamily": { "type": "string" },
        "bodyPt": { "type": "number", "exclusiveMinimum": 0 },
        "bodyLine": { "type": "number", "exclusiveMinimum": 0 },
        "hangingPunct": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "date", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$" },
          "date_override": {
            "type": "object",
            "required": ["value", "reason"],
            "properties": { "value": { "type": "string" }, "reason": { "type": "string" } }
          },
          "icon": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "derive": {
                "type": "object",
                "required": ["source", "box"],
                "properties": {
                  "source": { "type": "string" },
                  "box": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
                  "name": { "type": "string" }
                }
              }
            }
          },
          "reference": { "type": "object" },
          "source": { "type": "object" }
        }
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "expected_slide_count": { "type": "integer", "minimum": 1 },
        "forbidden_texts": { "type": "array", "items": { "type": "string" } },
        "status_words": { "type": "array", "items": { "type": "string" } },
        "max_image_area_pct": { "type": "number", "minimum": 0 },
        "min_objects": { "type": "integer", "minimum": 0 },
        "baseline_png": { "type": "string" },
        "detail_roi": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["text", "bold"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "bold": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "richBlock": {
      "type": "object",
      "required": ["runs", "box", "textBox"],
      "properties": {
        "text": { "type": "string", "description": "Verbatim source string; must equal the concatenation of runs." },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } },
        "box": { "$ref": "#/$defs/box" },
        "textBox": { "$ref": "#/$defs/box" },
        "fontPt": { "type": "number", "exclusiveMinimum": 0 },
        "lineSpacing": { "type": "number", "exclusiveMinimum": 0 },
        "reference_bbox_px": { "type": ["array", "null"] },
        "source_text_span": { "type": "string" }
      }
    },
    "researchCard": {
      "allOf": [{ "$ref": "#/$defs/richBlock" }],
      "properties": {
        "id": { "type": "string" },
        "icon": { "enum": ["chart", "layers", "network"] }
      }
    },
    "diagramBlock": {
      "type": "object",
      "required": ["id", "kind", "box", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["inputGrid", "researchList", "managementGrid"] },
        "box": { "$ref": "#/$defs/box" },
        "title": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "type": "string" } },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["header", "items"],
            "properties": {
              "header": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
